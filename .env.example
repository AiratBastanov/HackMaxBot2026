# Docker demo запускается без .env. Этот безопасный шаблон — для native demo.
APP_MODE=local
APP_INGRESS=webhook
ADMISSION_MODE=PUBLIC
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./runtime/demo.sqlite
MAX_WEBHOOK_SECRET=synthetic-test-secret-000000000000000000
PROBE_TTL_SECONDS=600
MAX_REQUEST_TIMEOUT_MS=5000
MAX_API_BASE_URL=https://platform-api2.max.ru
# Нет автоматического synthetic fallback. Путь читается один раз при startup.
FLOW_DATA_MODE=synthetic-test
PUBLIC_DISPLAY=NOT_CLEARED
DATA_SNAPSHOT_PATH=./runtime/synthetic-catalog.json
FLOW_TEST_CLOCK=2030-04-05T06:00:00.000Z
# Только явный технический тест: FLOW_DATA_MODE=synthetic-test
# FLOW_TEST_CLOCK=2030-04-05T06:00:00.000Z
# FLOW_TEST_CLOCK разрешён только в local synthetic-test, запрещён для настоящих клиентов.
# Read-only identity: .env.inspect.example. Live technical test: .env.live.example и docs/EXPLORATORY_MAX_RUNBOOK.md.
# Для настоящего MAX: .env.public.example; token обязателен, pairing отсутствует.
# MAX_EXPECTED_BOT_ID=PLACEHOLDER_ORGANIZER_BOT_ID
# MAX_BOT_TOKEN_FILE=/run/secrets/max_bot_token
# MAX_WEBHOOK_SECRET_FILE=/run/secrets/max_webhook_secret
# PUBLIC_BASE_URL=https://PLACEHOLDER_APPROVED_HOST
# LIVE_SCOPE_CONFIRMED=true
# NODE_EXTRA_CA_CERTS=/run/secrets/verified-official-ca.pem
