# compose.setup.yaml создаёт новый .env.public из этого примера и заполняет identity.
# Для native polling пути ниже относительны checkout; Docker заменяет их путями контейнера.
APP_MODE=live
APP_INGRESS=polling
ADMISSION_MODE=PUBLIC
DATABASE_PATH=runtime/public.sqlite
FLOW_DATA_MODE=real
DATA_SNAPSHOT_PATH=runtime/catalog/active.json
MAX_EXPECTED_BOT_ID=REPLACE_WITH_BOT_ID
MAX_CONSUMER_PORT=REPLACE_WITH_IDENTITY_PORT
MAX_BOT_TOKEN_FILE=secrets/max_bot_token
MAX_REQUEST_TIMEOUT_MS=5000
# GET /updates: ожидание сервера 0..90 с; клиентский deadline = ожидание + 5000 мс.
MAX_POLL_TIMEOUT_SECONDS=30
LIVE_SCOPE_CONFIRMED=true
# Оператор проверяет, что другой процесс/хост не потребляет этот бот.
LIVE_EXCLUSIVE_CONSUMER_CONFIRMED=true
# При необходимости: доверенный официальный CA, только для этого процесса.
# Native: NODE_EXTRA_CA_CERTS=secrets/max-official-root.pem
# Docker: NODE_EXTRA_CA_CERTS_CONTAINER=/run/secrets/max-official-root.pem
