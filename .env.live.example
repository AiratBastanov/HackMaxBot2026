# Из корня: docker compose --env-file .env.live -f deploy/compose.public.yaml ...
# Этот файл участвует в interpolation. Он не целиком импортируется в контейнер.
SOURCE_VERSION=PLACEHOLDER_REVIEWED_SOURCE_SHA
PUBLIC_HOST=PLACEHOLDER_APPROVED_HOST
ACME_EMAIL=PLACEHOLDER_APPROVED_OPERATOR_EMAIL
MAX_SECRETS_DIR=../secrets
REAL_CATALOG_DIR=../catalog/real
MAX_EXPECTED_BOT_ID=PLACEHOLDER_BOT_ID_FROM_ME
# Перенесите ID, порт и имя проекта из конфигурации identity-init своего бота.
MAX_CONSUMER_PORT=REPLACE_WITH_IDENTITY_PORT
COMPOSE_PROJECT_NAME=REPLACE_WITH_BOT_PROJECT
LIVE_SCOPE_CONFIRMED=false
# Параметры admin CLI на хосте (пути Compose выше относительны deploy/, эти — cwd):
APP_MODE=live
ADMISSION_MODE=PUBLIC
APP_INGRESS=webhook
DATABASE_PATH=./runtime/webhook/webhook.sqlite
MAX_BOT_TOKEN_FILE=./secrets/max_bot_token
MAX_WEBHOOK_SECRET_FILE=./secrets/max_webhook_secret
PUBLIC_BASE_URL=https://PLACEHOLDER_APPROVED_HOST
FLOW_DATA_MODE=real
DATA_SNAPSHOT_PATH=./catalog/real/active.json
# active.json задаёт относительные имена snapshot/review внутри того же каталога.
# Монтируется весь каталог; после activate требуется контролируемый restart app.
PUBLIC_DISPLAY=NOT_CLEARED
LIVE_SUBSCRIPTION_JOURNAL_DIR=./runtime/webhook/subscription-journal
# Только после проверки отсутствия Long Polling/другого consumer:
LIVE_EXCLUSIVE_CONSUMER_CONFIRMED=false
# Если нужен проверенный официальный CA, только локальные файлы; TLS не отключать:
# NODE_EXTRA_CA_CERTS_CONTAINER=/run/secrets/max-official-root.pem
# NODE_EXTRA_CA_CERTS=./secrets/max-official-root.pem
