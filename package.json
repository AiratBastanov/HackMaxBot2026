{
  "name": "maxbot-g1-technical-probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Культурный план: подбор событий и личные закладки в MAX",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "public:poll": "node --env-file=.env.public dist/scripts/start-polling.js",
    "organizer:check": "node dist/scripts/organizer-check.js",
    "test:public": "node --test --test-timeout=20000 dist/tests/public-access.test.js dist/tests/public-data.test.js",
    "real:catalog": "node dist/scripts/real-catalog.js",
    "real:smoke": "node dist/scripts/multi-city-verify.js",
    "real:preflight": "node --env-file=.env.polling dist/scripts/real-preflight.js",
    "flow:demo": "node dist/scripts/flow-walkthrough.js --synthetic",
    "flow:replay": "node dist/scripts/flow-walkthrough.js --real-replay",
    "test:flow": "node --test --test-timeout=20000 dist/tests/flow-*.test.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "data": "node dist/scripts/data.js",
    "test:data": "node --test --test-timeout=10000 dist/tests/data-*.test.js",
    "test:unit": "node --test --test-timeout=10000 dist/tests/config.test.js dist/tests/contracts.test.js dist/tests/live-admin.test.js",
    "test:integration": "node --test --test-timeout=20000 dist/tests/integration.test.js dist/tests/recovery.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "prepare:local": "node scripts/prepare-local.mjs",
    "start": "node --env-file=.env.local dist/src/index.js",
    "smoke": "node --env-file=.env.local dist/scripts/local-smoke.js",
    "live:inspect": "node --env-file=.env.inspect dist/scripts/live-admin.js inspect",
    "live:prepare": "node dist/scripts/prepare-max-test.js",
    "live:poll": "node --env-file=.env.polling dist/scripts/live-poll.js",
    "test:polling": "node --test --test-timeout=20000 dist/tests/polling.test.js",
    "recovery": "node dist/scripts/recovery.js",
    "live:subscribe": "node --env-file=.env.live dist/scripts/live-admin.js subscribe",
    "manifest": "node scripts/source-manifest.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "lossless-json": "4.3.1",
    "parse5": "8.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.4",
    "typescript": "7.0.2"
  }
}
