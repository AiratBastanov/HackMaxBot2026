# Только foreground тест без публичного origin и webhook secret.
APP_MODE=live
APP_INGRESS=test-polling
FLOW_DATA_MODE=synthetic-test
PUBLIC_DISPLAY=NOT_CLEARED
LIVE_SCOPE_CONFIRMED=true
MAX_BOT_TOKEN_FILE=./secrets/max_bot_token
# Оператор подтверждает ротацию после локальной замены; наличие файла не доказывает ротацию.
MAX_CREDENTIAL_ROTATION_CONFIRMED=false
# Только после проверки всех мест запуска; пустые subscriptions этого не доказывают.
LIVE_EXCLUSIVE_CONSUMER_CONFIRMED=false
# live:inspect добавит MAX_EXPECTED_BOT_ID после успешного GET /me.
# Согласившиеся числовые user_id через запятую; либо live:poll -- pair.
PROBE_TESTER_IDS=
DATA_SNAPSHOT_PATH=./runtime/max-test/synthetic-current.json
MAX_REQUEST_TIMEOUT_MS=5000
